# ==============================================================================
# AI-Powered Self-Healing Test Automation Framework — Environment Variables
# ==============================================================================
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# ==============================================================================

# --- LLM Provider API Keys ---
# Primary provider: Anthropic Claude
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Fallback provider: Google Gemini
GOOGLE_API_KEY=yAQ.Ab8RN6IJG0Vxrbo7Iee8x8hoG98zSTBREI9TiD3ZcQhNnOqZEw

# --- LLM Configuration ---
# Which provider to use as primary: "claude" or "gemini"
LLM_PRIMARY_PROVIDER=claude

# Claude model to use
CLAUDE_MODEL=claude-sonnet-4-20250514

# Gemini model to use
GEMINI_MODEL=gemini-2.0-flash

# --- Application Configuration ---
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Browser for UI tests: chromium, firefox, webkit
BROWSER=chromium

# Run browser in headless mode: true/false
HEADLESS=true

# Base URL for the demo application
DEMO_APP_BASE_URL=http://localhost:8000

# --- Database ---
# SQLite is the default; no configuration needed
# For PostgreSQL (optional):
# DATABASE_URL=postgresql://user:password@localhost:5432/qe_capstone
